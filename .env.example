# This deployment's own public address. The patient portal link is
# built from it, and a relative link is useless in a WhatsApp message.
NEXT_PUBLIC_APP_URL=

NEXT_PUBLIC_SUPABASE_URL=
# UI language: en | ar. Flips text and text direction together.
NEXT_PUBLIC_LOCALE=

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_ — that inlines it into the
# browser bundle. It bypasses RLS entirely, and is read only by
# lib/supabase/admin.ts for the /admin console.
SUPABASE_SECRET_KEY=

# Comma-separated emails allowed to reach /admin. Leave empty to disable the
# platform console completely.
PLATFORM_ADMIN_EMAILS=
