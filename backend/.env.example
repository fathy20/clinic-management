NODE_ENV=development
PORT=3001

# Owner role — runs migrations, owns the schema. Never used at runtime.
DATABASE_URL=postgres://physioflow_owner:local_dev_only@localhost:55432/physioflow

# Application role — non-superuser, RLS applies, no DELETE anywhere (FR-PLT-04, NFR-SEC-09).
DATABASE_APP_URL=postgres://physioflow_app:local_dev_only@localhost:55432/physioflow

REDIS_URL=redis://localhost:56379

# 32+ chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_change_me_change_me_change_me
JWT_REFRESH_SECRET=change_me_too_change_me_too_change_me_too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
